# ===== 个人智能学习系统 环境变量示例 =====
# 复制本文件为 .env 并填写。未配置 API Key 时，核心功能（进度/目标/复习）仍完整可用。

# --- 大模型（P0-b 起用，DeepSeek 为 OpenAI 兼容协议）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 复杂推理任务（批改/苏格拉底/深度分析）用 reasoner，常规任务用 chat
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# --- Embedding（RAG 用，P0-c 起用；注意：DeepSeek 官方不提供 embedding）---
# 默认接硅基流动 SiliconFlow 的 BGE 中文向量模型，OpenAI 兼容
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# --- 数据库（双模式：默认 SQLite，设置 DATABASE_URL 即切换 PostgreSQL/pgvector）---
# 本地 SQLite 文件路径（相对项目根目录；仅 SQLite 模式生效）
DATABASE_PATH=./data/smart-study.db

# 云端 PostgreSQL + pgvector 连接串（可选）。设置后自动切换 PG 模式，忽略上面的 DATABASE_PATH。
# 例：postgres://postgres:postgres@localhost:5432/smartstudy
# 需先准备好带 pgvector 扩展的 PostgreSQL（Docker 可用 pgvector/pgvector:pg16，见 docker-compose.yml）。
DATABASE_URL=
